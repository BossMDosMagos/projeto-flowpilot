<?xml version="1.0" encoding="utf-8"?>
<!--
  Bolha de velocidade do FlowPilot (R.layout.overlay_flowpilot).
  Bolha circular discreta e 100% arrastável.

  Mostrador: 3 CÉLULAS DE DÍGITO FIXAS (como segmentos de um LCD de relógio).
  Cada dígito ocupa sua própria matriz de largura constante e gravity=center,
  então o painel NÃO se move nem "puxa" os números — a velocidade simplesmente
  vai se formando dentro de cada célula, como num display digital real.
  O diámetro do círculo é definido no WindowManager.LayoutParams pelo
  OverlayService (aplicarPreferencias); aqui a raiz apenas preenche (match_parent).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/ov_bolha">

    <!-- Fileira dos 3 dígitos (células fixas, não se mexem) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/ov_d0"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:typeface="monospace"
            android:textColor="#00FF88"
            android:gravity="center" />

        <TextView
            android:id="@+id/ov_d1"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:typeface="monospace"
            android:textColor="#00FF88"
            android:gravity="center" />

        <TextView
            android:id="@+id/ov_d2"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="34sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:typeface="monospace"
            android:textColor="#00FF88"
            android:gravity="center" />
    </LinearLayout>

    <TextView
        android:id="@+id/ov_sufixo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="km/h"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:typeface="monospace"
        android:textColor="#99FFFFFF"
        android:letterSpacing="0.15"
        android:gravity="center" />
</LinearLayout>
