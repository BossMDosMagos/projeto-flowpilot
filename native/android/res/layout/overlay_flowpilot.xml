<?xml version="1.0" encoding="utf-8"?>
<!--
  Bolha de velocidade do FlowPilot (R.layout.overlay_flowpilot).
  Bolha circular discreta e 100% arrastável: apenas o número de velocidade
  (fonte DS-DIGIB sobre fundo escuro) mais o sufixo "km/h".
  O tamanho (diâmetro) e as cores são aplicados dinamicamente pelo OverlayService
  conforme as preferências do usuário (aplicarPreferencias).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_raiz"
    android:layout_width="92dp"
    android:layout_height="92dp"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/ov_bolha">

    <TextView
        android:id="@+id/ov_vel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="34sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:textColor="#00FF88"
        android:shadowColor="#1100FF66"
        android:shadowRadius="8"
        android:gravity="center" />

    <TextView
        android:id="@+id/ov_sufixo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="km/h"
        android:textSize="10sp"
        android:includeFontPadding="false"
        android:textColor="#99FFFFFF"
        android:letterSpacing="0.15"
        android:gravity="center" />
</LinearLayout>
