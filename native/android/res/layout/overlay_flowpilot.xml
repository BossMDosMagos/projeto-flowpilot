<?xml version="1.0" encoding="utf-8"?>
<!--
  Bolha de velocidade do FlowPilot (R.layout.overlay_flowpilot).

  ESTRUTURA (FrameLayout fixo 100dp com fundo circular):
    - Camada FUNDO (ov_mask): "888" (máscara máxima de 7 segmentos), cor
      cinza bem translúcida (#1f000000), SEM sombra/brilho — segmentos apagados.
    - Camada FRENTE (ov_vel): valor real da velocidade, sobreposta exatamente
      em cima da máscara, alinhada À DIREITA para coincidir com as casas do "888"
      (ex.: 0 km/h => "0" sobre o último "8").
    - Sufixo "km/h": na parte inferior, centralizado.

  Ambas as camadas usam a MESMA fonte, MESMO tamanho e MESMA largura para o
  alinhamento exato dos dígitos.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_raiz"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:background="@drawable/ov_bolha">

    <!-- CAMADA DE FUNDO / INATIVO: "888" fixo, bem translúcido, sem brilho -->
    <TextView
        android:id="@+id/ov_mask"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="888"
        android:textSize="34sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:typeface="monospace"
        android:textColor="#1f000000"
        android:gravity="center"
        android:shadowColor="@android:color/transparent"
        android:shadowRadius="0" />

    <!-- CAMADA DE FRENTE / ATIVO: valor real, sobreposto, alinhado à direita -->
    <TextView
        android:id="@+id/ov_vel"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="0"
        android:textSize="34sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:typeface="monospace"
        android:textColor="#000000"
        android:gravity="end|center_vertical"
        android:shadowColor="#66007700"
        android:shadowRadius="4"
        android:shadowDx="0"
        android:shadowDy="0" />

    <!-- SUFIXO: unidade de medida, centralizada na parte inferior -->
    <TextView
        android:id="@+id/ov_sufixo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="km/h"
        android:textSize="10sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textColor="#99FFFFFF"
        android:letterSpacing="0.15"
        android:gravity="center" />
</FrameLayout>
