<?xml version="1.0" encoding="utf-8"?>
<!--
  Bolha de velocidade do FlowPilot (R.layout.overlay_flowpilot).

  ESTRUTURA (FrameLayout fixo 100dp com fundo circular):
    - Camada FUNDO (ov_mask): "~~~" (na fonte DSEG14, cada '~' acende os 14
      segmentos completos), cor preta bem translúcida (#25000000) — a malha
      completa do display de LCD.
    - Camada FRENTE (ov_vel): valor real da velocidade, sobreposta exatamente
      em cima da máscara, alinhada À DIREITA para se sobrepor à malha "~~~"
      (ex.: 0 km/h => "0" sobre a última coluna).
    - Sufixo "km/h": na parte inferior, centralizado.

  Ambas as camadas usam a MESMA fonte (DSEG14), MESMO tamanho e MESMA largura
  para o alinhamento exato dos dígitos.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_raiz"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:background="@drawable/ov_bolha">

    <!-- CAMADA DE FUNDO / INATIVO: "~~~" (malha completa), bem translúcido, sem brilho -->
    <TextView
        android:id="@+id/ov_mask"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="~~~"
        android:textSize="36sp"
        android:includeFontPadding="false"
        android:textColor="#25000000"
        android:gravity="end|center_vertical"
        android:shadowColor="@android:color/transparent"
        android:shadowRadius="0" />

    <!-- CAMADA DE FRENTE / ATIVO: valor real, sobreposto, alinhado à direita -->
    <TextView
        android:id="@+id/ov_vel"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="0"
        android:textSize="36sp"
        android:includeFontPadding="false"
        android:textColor="#000000"
        android:gravity="end|center_vertical"
        android:shadowColor="@android:color/transparent"
        android:shadowRadius="0" />

    <!-- SUFIXO: unidade de medida, centralizada na parte inferior -->
    <TextView
        android:id="@+id/ov_sufixo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="km/h"
        android:textSize="10sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textColor="#99FFFFFF"
        android:letterSpacing="0.15"
        android:gravity="center" />
</FrameLayout>
